APP_NAME=FixIt API
APP_VERSION=0.3.0
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fixit
SESSION_COOKIE_NAME=fixit_session
